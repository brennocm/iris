root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
# The default Kotlin style in Android Studio; ktlint_official rewraps most signatures.
ktlint_code_style = intellij_idea

[*.go]
indent_style = tab

[*.{c,h}]
indent_style = space
indent_size = 4
